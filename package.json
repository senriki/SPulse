{
  "name": "spulse",
  "version": "1.3.0",
  "description": "Audio waveform visualizer and MP4 exporter",
  "author": "Senriki <senrikis@gmail.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --config electron-builder.config.js",
    "build:win": "electron-builder --config electron-builder.config.js --win",
    "build:win:portable": "electron-builder --config electron-builder.config.js --win portable --publish never",
    "build:mac": "electron-builder --config electron-builder.config.js --mac",
    "build:linux": "electron-builder --config electron-builder.config.js --linux",
    "icon": "node scripts/gen-icon.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('out',{recursive:true,force:true})\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.16.0"
  }
}
